# Mobile Tavern 最小社区 Nginx 站点配置示例
#
# 部署位置：/etc/nginx/sites-available/mobile-tavern-community
#           并软链到 /etc/nginx/sites-enabled/
# 修改后验证并重载：sudo nginx -t && sudo systemctl reload nginx
#
# 注意：本文件是示例，SSL 证书路径、域名按服务器实际情况填写。
# 若服务器使用自建完整 http 配置（非发行版默认 nginx.conf），必须在 http 块
# 引入 `include /etc/nginx/mime.types;`，否则角色卡 PNG 会以 text/plain 输出，
# 配合 nosniff 后 WebView 会拒绝把封面当图片渲染，表现为"图片无法加载"。

server {
    listen 443 ssl;
    server_name community.neural-node.xyz;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    # 角色卡单文件上限 20MB，加上 multipart 开销
    client_max_body_size 21m;

    # API 反向代理到 Rust 服务。
    # 跨域响应头由服务的 CorsLayer 统一处理，Nginx 不需要（也不要）重复加。
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 透传 Cloudflare 真实访客 IP，供上传限频使用
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8080;
    }

    location = /health/deep {
        proxy_pass http://127.0.0.1:8080;
    }

    # 角色卡静态文件：Nginx 直接映射磁盘目录，不经过 Rust 服务，
    # 因此 CorsLayer 不会生效，必须在这里单独补 CORS 响应头。
    #
    # 缺失后果：App WebView 内 fetch() 下载会被浏览器内核拦截（TypeError:
    # Failed to fetch），表现为"下载失败"；而列表封面 <img> 不受 CORS 约束，
    # 会出现"封面能显示、下载必失败"的假象。
    location /cards/ {
        alias /var/lib/mobile-tavern/uploads/cards/;

        # 仅放行 Tauri App 来源（Android 为 https://tauri.localhost，
    # iOS 为 tauri://localhost）；其他来源不返回 ACAO，
    # 浏览器将拒绝其跨域读取。空值时 Nginx 不会发送该响应头。
    set $mt_cors_origin "";
    if ($http_origin ~ ^(https?://tauri\.localhost|tauri://localhost)$) {
            set $mt_cors_origin $http_origin;
        }
        add_header Access-Control-Allow-Origin $mt_cors_origin always;
        add_header Vary Origin always;

        add_header X-Content-Type-Options nosniff always;

        # 文件不可变（文件名为 UUID），可长缓存
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 角色卡封面缩略图：Nginx 直接映射磁盘目录，规则与 /cards/ 一致。
    location /thumbnails/ {
        alias /var/lib/mobile-tavern/uploads/thumbnails/;

        set $mt_cors_origin "";
        if ($http_origin ~ ^(https?://tauri\.localhost|tauri://localhost)$) {
            set $mt_cors_origin $http_origin;
        }
        add_header Access-Control-Allow-Origin $mt_cors_origin always;
        add_header Vary Origin always;

        add_header X-Content-Type-Options nosniff always;

        # 缩略图不可变（文件名与角色卡 ID 绑定），可长缓存
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
