[Unit]
Description=Mobile Tavern minimal character card community
After=network.target

[Service]
Type=simple
User=mobile-tavern
Group=mobile-tavern
WorkingDirectory=/opt/mobile-tavern-community
EnvironmentFile=/opt/mobile-tavern-community/.env
ExecStart=/opt/mobile-tavern-community/mobile-tavern-community
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mobile-tavern

[Install]
WantedBy=multi-user.target
