# Mobile Tavern 最小社区云端服务配置
# 此文件只属于 cloud/minimal-community，不得被移动端构建读取。

PORT=8080
RUST_LOG=info,mobile_tavern_community=debug

# 生产环境建议使用绝对路径。
DATA_DIR=/var/lib/mobile-tavern

# 多个 Origin 使用英文逗号分隔。
CORS_ALLOWED_ORIGINS=tauri://localhost,https://community.neural-node.xyz

# 存储上限与来源 IP 上传限流。
MAX_STORAGE_BYTES=8589934592
MAX_UPLOADS_PER_WINDOW=3
UPLOAD_WINDOW_SECONDS=600

# 至少 32 个字符；留空时管理员删除接口保持关闭。
ADMIN_TOKEN=
