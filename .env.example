# Mobile Tavern 本地 Node 开发服务与公开构建配置
# 复制为 .env 后按需填写。移动端用户 API Key 不在这里配置。

# Node 开发服务
NODE_ENV=development
PORT=3000
# 默认仅监听本机；确需局域网联调时再显式改为对应网卡地址。
TAURI_DEV_HOST=127.0.0.1

# 本地令牌与试用 Key 加密；生产运行 server.ts 时三项必须显式提供。
HMAC_SIGN_KEY=
AES_ENCRYPT_KEY=
REAL_API_KEY=
# REAL_API_KEY 的兼容别名，仅保留一个即可。
TRIAL_OPENROUTER_KEY=

# 本地猫助手代理；DASHSCOPE_API_KEY 为空时使用本地规则降级。
CATBOT_FC_URL=https://catbot-gmkodirnhh.cn-hangzhou.fcapp.run/api/catbot
DASHSCOPE_API_KEY=

# 注入移动端包的公开变量。VITE_ 前缀内容会进入客户端，严禁填写秘密。
VITE_COMMUNITY_ORIGIN=https://community.neural-node.xyz
# 留空时开发构建开启、生产构建关闭。
VITE_COMMUNITY_ENABLED=
VITE_COMMUNITY_MIN_FIRST_USE_AGE_DAYS=0
VITE_COMMUNITY_MIN_CUMULATIVE_USAGE_HOURS=0

# 开发工具开关
DISABLE_HMR=false
